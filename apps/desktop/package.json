{
  "name": "silvermoon",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "银月（SilverMoon）—— 本地优先全媒体库应用（Tauri 2 + Vue 3 + Rust）",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "start": "tauri dev",
    "tauri": "tauri",
    "build": "npm run typecheck && npm run build:renderer && tauri build",
    "build:renderer": "vite build",
    "verify:word-lyrics": "node scripts/verify-word-lyrics.mjs",
    "verify:tag-sources": "node scripts/verify-music-tag-sources.mjs",
    "verify:mock-coverage": "node scripts/check-mock-coverage.mjs",
    "gen:settings-index": "node scripts/gen-settings-index.mjs",
    "verify:settings-index": "node scripts/gen-settings-index.mjs --check",
    "build:backend": "cargo build --manifest-path src-tauri/Cargo.toml",
    "build:backend:release": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "typecheck": "vue-tsc --noEmit",
    "dist": "tauri build",
    "dist:dir": "tauri build --no-bundle",
    "test": "vitest run",
    "bench:memory": "node scripts/bench-memory.mjs",
    "pack:skins": "node scripts/pack-example-skins.mjs",
    "lint": "node scripts/check-version.mjs && eslint .",
    "lint:fix": "eslint . --fix",
    "check:version": "node scripts/check-version.mjs",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"shared/**/*.{ts,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\" \"shared/**/*.{ts,json}\" \"scripts/**/*.mjs\"",
    "verify:rust-pure": "node scripts/verify-rust-pure.mjs",
    "fetch:icon-font": "node scripts/fetch-icon-font.mjs",
    "check:icon-font": "node scripts/fetch-icon-font.mjs --check"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.6.0",
    "@m3e/web": "^2.8.2",
    "@material/material-color-utilities": "^0.3.0",
    "@material/web": "^2.2.0",
    "artplayer": "^5.4.0",
    "artplayer-plugin-danmuku": "^5.3.0",
    "dompurify": "^3.4.16",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "hls.js": "^1.7.1",
    "leafer-editor": "^2.2.11",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^2.2.6",
    "qrcode": "^1.5.4",
    "taglib-wasm": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10",
    "@tauri-apps/cli": "^2"
  }
}
