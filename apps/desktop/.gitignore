# rust
backend/target/
splash/target/
backend/gen/schemas/
backend/.tauri/

# rust —— win7 tier-3 构建用的是独立的 target-dir（见 package.json 的
# build:backend:win7 / build:splash:win7），路径是 <crate>/target/win7/
backend/target/win7/
splash/target/win7/
# 以及在 apps/desktop 下整体构建时的 --target-dir target/win7
target/win7/
# 本地验证 parking_lot_core 补丁时可能在 patches 目录下留下 target/
patches/*/target/
patches/*/Cargo.lock

