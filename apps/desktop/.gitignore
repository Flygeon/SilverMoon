# dependencies
node_modules/

# front-end build output
dist/
# Electron 主进程构建产物（scripts/build-electron.mjs）
dist-electron/
# 构建期临时目录（本机 TEMP 若被沙箱禁用，用 TEMP=$(pwd)/.tmpbuild 绕过）
.tmpbuild/

# ⚠️ 例外：示例扩展的 web/dist 是**交付物**，不是构建产物。
# 扩展以成品分发（安装即用，用户侧不构建），所以它的预构建前端必须入库；
# 少了它示例就是坏的。注意必须先放行目录本身再放行内容 ——
# git 的规则是「父目录被排除时，无法用 ! 重新包含其中的文件」。
!example/extensions/*/web/dist/
!example/extensions/*/web/dist/**

# 打包产物不入库：示例扩展的 zip 是本地按指南现场打的，会随源码变更过期。
# 注意只限 extensions/ 下 —— example/skins/ 的皮肤 zip 是有意入库的分发件。
example/extensions/*/*.zip

# electron-builder output（历史目录，迁回 Tauri 后不再产生）
release/

# 启动器（独立原生小程序）的构建产物
splash/target/

# 启动器产物：CI 打包前从 splash/target 拷进来（见 .github/workflows/build.yml）
src-tauri/splash-bin/

# rust / tauri
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/.tauri/

# logs
*.log
crash_log.txt

# os
.DS_Store
Thumbs.db

# ide
.idea/
*.swp
.vscode/

# local agent workspace memory
.workbuddy/

# build artifacts (deliverables, do not commit)
*.exe
*.apk
*.AppImage
*.msi
*.dmg

# reference projects (kept locally as research material, not part of the build)
小说阅读器参考/
在线播放参考/
播放器参考/
播放器参考项目/
歌词获取项目参考/
小说项目参考/
图片视频索引项目参考/
pixiv图片客户端参考/
ECHO播放器参考/
酷狗音乐平台参考/
花笺参考项目/
.trae-html-share-packages/

# local reference projects and workspace artifacts
