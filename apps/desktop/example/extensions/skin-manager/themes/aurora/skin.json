{
  "formatVersion": 1,
  "manifest": {
    "id": "aurora",
    "name": "极光",
    "version": "1.0.0",
    "author": "SilverMoon",
    "description": "演示用扩展主题：冷色极光的纯令牌皮肤（v1），无任何外部资源。",
    "modes": [
      "light",
      "dark"
    ],
    "seedColor": false,
    "accent": "#6D8CFF"
  },
  "tokens": {
    "light": {
      "--md-sys-color-primary": "#4A5FC1",
      "--md-sys-color-on-primary": "#FFFFFF",
      "--md-sys-color-primary-container": "#DDE1FF",
      "--md-sys-color-on-primary-container": "#00105C",
      "--md-sys-color-secondary": "#3F6E8C",
      "--md-sys-color-on-secondary": "#FFFFFF",
      "--md-sys-color-secondary-container": "#C7E7FF",
      "--md-sys-color-on-secondary-container": "#001E2E",
      "--md-sys-color-tertiary": "#7A4E9E",
      "--md-sys-color-on-tertiary": "#FFFFFF",
      "--md-sys-color-tertiary-container": "#F0DAFF",
      "--md-sys-color-on-tertiary-container": "#2C0050",
      "--md-sys-color-surface": "#FAF9FF",
      "--md-sys-color-on-surface": "#1A1B21",
      "--md-sys-color-surface-dim": "#DAD9E0",
      "--md-sys-color-surface-bright": "#FAF9FF",
      "--md-sys-color-surface-container-lowest": "#FFFFFF",
      "--md-sys-color-surface-container-low": "#F4F3FA",
      "--md-sys-color-surface-container": "#EEEDF4",
      "--md-sys-color-surface-container-high": "#E8E7EE",
      "--md-sys-color-surface-container-highest": "#E2E1E9",
      "--md-sys-color-on-surface-variant": "#46464F",
      "--md-sys-color-outline": "#767680",
      "--md-sys-color-outline-variant": "#C7C5D0",
      "--md-sys-color-inverse-surface": "#2F3036",
      "--md-sys-color-inverse-on-surface": "#F1F0F7",
      "--md-sys-color-inverse-primary": "#B9C3FF",
      "--md-sys-color-on-background": "#1A1B21",
      "--md-sys-color-background": "#FAF9FF",
      "--lm-scrim-surface": "rgba(250, 249, 255, 0.75)",
      "--lm-hairline": "rgba(74, 95, 193, 0.14)"
    },
    "dark": {
      "--md-sys-color-primary": "#B9C3FF",
      "--md-sys-color-on-primary": "#1B2A80",
      "--md-sys-color-primary-container": "#33409E",
      "--md-sys-color-on-primary-container": "#DDE1FF",
      "--md-sys-color-secondary": "#93CCE8",
      "--md-sys-color-on-secondary": "#00354B",
      "--md-sys-color-secondary-container": "#22546F",
      "--md-sys-color-on-secondary-container": "#C7E7FF",
      "--md-sys-color-tertiary": "#D6B8F5",
      "--md-sys-color-on-tertiary": "#451C68",
      "--md-sys-color-tertiary-container": "#5D3480",
      "--md-sys-color-on-tertiary-container": "#F0DAFF",
      "--md-sys-color-surface": "#121319",
      "--md-sys-color-on-surface": "#E3E1E9",
      "--md-sys-color-surface-dim": "#121319",
      "--md-sys-color-surface-bright": "#383940",
      "--md-sys-color-surface-container-lowest": "#0D0E13",
      "--md-sys-color-surface-container-low": "#1A1B21",
      "--md-sys-color-surface-container": "#1F2026",
      "--md-sys-color-surface-container-high": "#292A30",
      "--md-sys-color-surface-container-highest": "#34343B",
      "--md-sys-color-on-surface-variant": "#C6C5CF",
      "--md-sys-color-outline": "#90909A",
      "--md-sys-color-outline-variant": "#46464F",
      "--md-sys-color-inverse-surface": "#E3E1E9",
      "--md-sys-color-inverse-on-surface": "#2F3036",
      "--md-sys-color-inverse-primary": "#4A5FC1",
      "--md-sys-color-on-background": "#E3E1E9",
      "--md-sys-color-background": "#121319",
      "--lm-scrim-surface": "rgba(18, 19, 25, 0.78)",
      "--lm-hairline": "rgba(185, 195, 255, 0.12)"
    }
  },
  "css": "/* 极光：给导航与按钮加一层冷色微光 */\n.nav-item.active .indicator { box-shadow: 0 0 0 1px color-mix(in srgb, var(--md-sys-color-primary) 40%, transparent), 0 4px 18px color-mix(in srgb, var(--md-sys-color-primary) 30%, transparent); }\n.lm-btn--filled:hover { box-shadow: 0 4px 16px color-mix(in srgb, var(--md-sys-color-primary) 40%, transparent); }"
}
