{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "anime-webview",
  "description": "隐藏取流窗口能力（不可见，仅跑注入脚本抓 m3u8）",
  "windows": [
    "anime-webview"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:webview:allow-internal-toggle-devtools"
  ],
  "remote": {
    "urls": [
      "https://**",
      "http://**"
    ]
  }
}
