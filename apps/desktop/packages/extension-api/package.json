{
  "name": "@silvermoon/extension-api",
  "version": "2.0.0",
  "description": "银月（SilverMoon）扩展作者 SDK：manifest 类型、宿主 iframe 桥客户端与 Vite 构建插件",
  "license": "GPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "silvermoon",
    "extension",
    "manifest",
    "vite-plugin",
    "bridge"
  ],
  "files": [
    "src",
    "templates",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "import": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./bridge": {
      "types": "./src/bridge.ts",
      "import": "./src/bridge.ts",
      "default": "./src/bridge.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
