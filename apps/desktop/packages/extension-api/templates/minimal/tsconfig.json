{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@silvermoon/extension-api": ["../../src/index.ts"],
      "@silvermoon/extension-api/vite": ["../../src/vite.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
