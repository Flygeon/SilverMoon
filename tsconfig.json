{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2021", "ES2022.Intl", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"],
      "@tauri-apps/api/core": ["src/shims/api/core.ts"],
      "@tauri-apps/api/event": ["src/shims/api/event.ts"],
      "@tauri-apps/api/window": ["src/shims/api/window.ts"],
      "@tauri-apps/api/webview": ["src/shims/api/webview.ts"],
      "@tauri-apps/api/webviewWindow": ["src/shims/api/webviewWindow.ts"],
      "@tauri-apps/api/dpi": ["src/shims/api/dpi.ts"],
      "@tauri-apps/api/path": ["src/shims/api/path.ts"],
      "@tauri-apps/api/app": ["src/shims/api/app.ts"],
      "@tauri-apps/plugin-store": ["src/shims/plugin-store.ts"],
      "@tauri-apps/plugin-dialog": ["src/shims/plugin-dialog.ts"],
      "@tauri-apps/plugin-fs": ["src/shims/plugin-fs.ts"],
      "@tauri-apps/plugin-opener": ["src/shims/plugin-opener.ts"],
      "@tauri-apps/plugin-http": ["src/shims/plugin-http.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "shared/**/*.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
